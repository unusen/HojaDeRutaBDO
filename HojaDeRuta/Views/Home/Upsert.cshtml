@using HojaDeRuta.Models.DAO
@using HojaDeRuta.Models.Enums
@using System.Text.Json
@model HojaDeRuta.Models.DAO.Hoja

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = @ViewData["Title"];

    bool botonesHabilitados = (bool)(ViewBag.HabilitarBotones ?? false);
    bool puedeModificar = (bool)(ViewBag.PuedeModificar ?? false);
    var estadosDeHoja = Model.HojaEstados.ToList();
    string rechazo = (ViewBag.Rechazo ?? "");
    var workflowStageOrder = new[] { "Reviso", "RevisionGerente", "EngagementPartner", "SocioFirmante" };
    var etapaActual = ViewBag.EtapaActual as string;
    var maxUploadFileSizeBytes = Convert.ToInt64(ViewBag.MaxUploadFileSizeBytes ?? 60L * 1024L * 1024L);
    var maxUploadFileSizeLabel = ViewBag.MaxUploadFileSizeLabel as string ?? "60 MB";

    if (string.IsNullOrWhiteSpace(etapaActual))
    {
        etapaActual = Model.Estado == (int)Estado.Pendiente
            ? workflowStageOrder.FirstOrDefault(stage =>
                estadosDeHoja.Any(e => e.Etapa == stage && e.Estado == (int)Estado.Pendiente))
            : null;
    }
}

@functions {

    public string GetDisabledAttribute(string fieldName)
    {
        var habilitado = ViewBag.CampoHabilitado as string;
        return fieldName == habilitado ? null : "disabled";
    }

    public string DisabledByDetail()
    {
        return @ViewBag.Detail ? "disabled" : null;
    }

    public string GetCampoHabilitadoClass()
    {
        var currentMode = (ViewMode)ViewBag.ViewMode;

        return (currentMode == ViewMode.Update)
                            ? "campoHabilitado" //clase css
                           : "";
    }

}

<div class="container-fluid content-wrapper">

    <h3 class="mb-2 mt-2 fs-4 text-center color-bdo">@ViewData["Title"]</h3>

    <div class="border border-2 rounded-3 p-3">

        <form id="hojaForm" asp-controller="Home" asp-action="Upsert" method="post" enctype="multipart/form-data">
            @if (Model.Estado != (int)Estado.Aprobada)
            {
                <div id="contenedorErroresUnificado" class="alert alert-danger alert-dismissible fade show mb-3 @(ViewBag.ErrorArchivo == null ? "d-none" : "")" role="alert">
                    <i class="bi bi-x-circle-fill me-2"></i>
                    <strong>Atención: No se puede avanzar por los siguientes motivos:</strong>
                    <ul id="listaErrores" class="mt-2 mb-0">
                        @if (ViewBag.ErrorArchivo != null)
                        {
                            <li id="errorArchivoFisico" data-severity="error">
                                <span>@ViewBag.ErrorArchivo</span>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-2 py-0" data-reverificar-archivo="@Model.Id" style="font-size: 0.75rem; vertical-align: middle;">
                                    <i class="bi bi-arrow-clockwise"></i> Verificar ahora
                                </button>
                            </li>
                        }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
                
                if (ViewBag.AdvertenciaArchivo != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @ViewBag.AdvertenciaArchivo
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }
            @if (!string.IsNullOrWhiteSpace(ViewBag.AdvertenciaAuditoria as string))
            {
                <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                    @ViewBag.AdvertenciaAuditoria
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <fieldset disabled=@DisabledByDetail()>
                <div class="row">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" id="Manejador" asp-for="Manejador" />
                    <input type="hidden" id="Estado" asp-for="Estado" />
                    <input type="hidden" asp-for="ArchivoTemp" />
                    <input type="hidden" asp-for="ArchivoHash" />
                    <input type="hidden" id="forceNumeroReassignment" name="forceNumeroReassignment" value="false" />
                    <input type="hidden" id="reservedNumero" name="reservedNumero" value="" />
                    <input type="hidden" id="AuditoriaActivo" name="Auditoria.Activo" />
                    <input type="hidden" id="AuditoriaPasivo" name="Auditoria.Pasivo" />
                    <input type="hidden" id="AuditoriaPatrimonioNeto" name="Auditoria.PatrimonioNeto" />
                    <input type="hidden" id="AuditoriaMoneda" name="Auditoria.Moneda" />
                    <input type="hidden" id="AuditoriaTipoNumeracion" name="Auditoria.TipoNumeracion" />
                    <input type="hidden" id="AuditoriaResultado" name="Auditoria.Resultado" />
                    <input type="hidden" id="AuditoriaTotalIngresos" name="Auditoria.TotalIngresos" />
                    <input type="hidden" id="AuditoriaTotalOtrosIngresos" name="Auditoria.TotalOtrosIngresos" />

                    @if (Model.HojaEstados != null)
                    {
                        for (int i = 0; i < Model.HojaEstados.Count(); i++)
                        {
                            var estado = Model.HojaEstados.ElementAt(i);

                            <input type="hidden" name="HojaEstados[@i].HojaEstadoId" value="@estado.HojaEstadoId" />
                            <input type="hidden" name="HojaEstados[@i].HojaId" value="@estado.HojaId" />
                            <input type="hidden" name="HojaEstados[@i].Etapa" value="@estado.Etapa" />
                            <input type="hidden" name="HojaEstados[@i].Estado" value="@estado.Estado" />
                            <input type="hidden" name="HojaEstados[@i].Revisor" value="@estado.Revisor" />
                            <input type="hidden" name="HojaEstados[@i].MotivoDeRechazo" value="@estado.MotivoDeRechazo" />
                        }
                    }

                    <div class="col-auto">
                        <label asp-for="Cliente" class="form-label form-label-sm mb-0">Cliente <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-4">
                        <select asp-for="Cliente" asp-items="@ViewBag.Clientes" id="Cliente"
                                disabled=@DisabledByDetail() class="form-select form-select-sm"
                                >
                            <option value="">Seleccione Cliente</option>
                        </select>
                        <span asp-validation-for="Cliente" class="text-danger small"></span>
                    </div>

                    <div class="col-auto">
                        <label asp-for="Sector" class="form-label form-label-sm mb-0">Sector <span class="text-danger">*</span></label>
                    </div>
                    <div class="col">
                        <select asp-for="Sector" asp-items="@ViewBag.Sectores" id="Sector" disabled=@DisabledByDetail()
                                class="form-select form-select-sm readonly">
                            <option value="">Seleccione Sector</option>
                        </select><span asp-validation-for="Sector" class="text-danger small"></span>
                    </div>

                    <div class="col-auto">
                        <label asp-for="Subarea" class="form-label form-label-sm mb-0">Subarea <span class="text-danger">*</span></label>
                    </div>
                    <div class="col">
                        <select asp-for="Subarea" id="subarea" disabled=@DisabledByDetail() class="form-select form-select-sm">
                            <option value="">Seleccione SubArea</option>
                        </select>
                        <span asp-validation-for="Subarea" class="text-danger small"></span>
                    </div>

                    <div class="col-auto">
                        <label asp-for="Numero" class="form-label form-label-sm mb-0">Nº</label>
                    </div>
                    <div class="col-md-1">
                        <input asp-for="Numero" type="text" class="form-control form-control-sm" placeholder="Número" readonly>
                    </div>

                </div>

                <div class="row mt-3">
                    <div class="col-auto">
                        <label for="nombreGenerico" class="form-label small">Nombre generico: <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-3">
                        <select asp-for="NombreGenerico" asp-items="@ViewBag.NombreGenerico" id="NombreGenerico" class="form-select form-select-sm">
                            <option value="">Seleccione Tipo de Documento</option>
                        </select>
                        <span asp-validation-for="NombreGenerico" class="text-danger small"></span>
                    </div>
                    <div class="col-auto">
                        <label for="Descripcion" class="form-label small">Descripción: <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-3">
                        <input asp-for="Descripcion" type="text" class="form-control form-control-sm" id="descripcion" placeholder="Descripcion">
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>
                    <div class="col-auto">
                        <label for="FechaDocumento" class="form-label small">Fecha doc.:</label>
                    </div>
                    <div class="col-md-2">
                        @* <input asp-for="FechaDocumento" type="text" id="fechaDocumento" class="form-control form-control-sm" placeholder="Fecha Documento" data-date-toggle /> *@
                        <input asp-for="FechaDocumento" type="date" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-auto">
                        <label asp-for="IsSindico" class="form-label form-label-sm mb-0">Requiere síndico</label>
                    </div>
                    <div class="col-md-1">
                        <select id="IsSindico" asp-for="IsSindico" class="form-select form-select-sm">
                            <option value="false"> NO</option>
                            <option value="true"> SI</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <label asp-for="Sindico" class="form-label form-label-sm mb-0">Síndico</label>
                    </div>
                    <div class="col-md-2">
                        <select asp-for="Sindico" asp-items="@ViewBag.Sindicos" id="Sindico" class="form-select form-select-sm" disabled>
                            <option value="">Seleccione Sindico</option>
                        </select>
                        <input type="hidden" asp-for="Sindico" />
                    </div>

                    <div class="col-auto">
                        <label asp-for="CodCliente" class="form-label form-label-sm mb-0">Cod. Cliente</label>
                    </div>
                    <div class="col-md-1">
                        <input asp-for="CodCliente" type="text" class="form-control form-control-sm"
                               id="CodCliente" readonly>
                    </div>

                    <div class="col-auto">
                        <label asp-for="ContratoPlataforma" class="form-label form-label-sm mb-0">Contrato Plataforma <span class="text-danger">*</span></label>
                    </div>
                    <div class="col-md-3">
                        <select asp-for="ContratoPlataforma" asp-items="@ViewBag.ContratosPlataforma" id="ContratoPlataforma" class="form-select form-select-sm">
                            <option value="">Seleccione Contrato Plataforma</option>
                        </select>
                        <span asp-validation-for="ContratoPlataforma" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="col-md-2">
                                <label for="Preparo" class="form-label fs-6">Preparó:</label>
                            </div>
                            <div class="col-md-7">
                                <input asp-for="Preparo" type="text" class="form-control form-control-sm"
                                       id="Preparo" data-value="@Model.Preparo" readonly>
                                <input type="hidden" asp-for="Preparo" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="PreparoFecha" type="date" id="preparoFecha" class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="row mt-3 @(string.Equals(etapaActual, "Reviso", StringComparison.OrdinalIgnoreCase) ? "workflow-stage-row is-current-stage" : "workflow-stage-row")">
                            <div class="col-md-2">
                                <label for="Reviso" class="form-label fs-6">Revisó:</label>
                            </div>
                            <div class="col-md-5">
                                <select asp-for="Reviso" asp-items="@ViewBag.Revisores" id="reviso" class="form-select form-select-sm"
                                        data-placeholder="Seleccione Revisor"
                                        data-value="@Model.Reviso">
                                    <option value="">Seleccione Revisor</option>
                                </select>
                                <input type="hidden" asp-for="Reviso" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="RevisoFecha" type="text" id="revisoFecha" class="form-control form-control-sm" placeholder="Fecha" data-date-toggle />
                            </div>
                            <div class="col-md-2 text-center">
                                <estado-badge etapa="Reviso" estados="@(estadosDeHoja)"></estado-badge>
                            </div>
                        </div>

                        <div class="row mt-3 @(string.Equals(etapaActual, "RevisionGerente", StringComparison.OrdinalIgnoreCase) ? "workflow-stage-row is-current-stage" : "workflow-stage-row")">
                            <div class="col-md-2">
                                <label for="RevisionGerente" class="form-label fs-6">Gerente/Dir.:</label>
                            </div>
                            <div class="col-md-5">
                                <select asp-for="RevisionGerente" asp-items="@ViewBag.Revisores" id="revisoGerente" class="form-select form-select-sm"
                                        data-placeholder="Seleccione Revisor Gerente"
                                        data-value="@Model.RevisionGerente" disabled>
                                    <option value="">Seleccione Revisor Gerente</option>
                                </select>
                                <input type="hidden" asp-for="RevisionGerente" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="RevisionGerenteFecha" type="text" id="revisoGerenteFecha" class="form-control form-control-sm" placeholder="Fecha" data-date-toggle />
                            </div>
                            <div class="col-md-2 text-center">
                                <estado-badge etapa="RevisionGerente" estados="@(estadosDeHoja)"></estado-badge>
                            </div>
                        </div>

                        <div class="row mt-3 @(string.Equals(etapaActual, "EngagementPartner", StringComparison.OrdinalIgnoreCase) ? "workflow-stage-row is-current-stage" : "workflow-stage-row")">
                            <div class="col-md-2">
                                <label for="EngagementPartner" class="form-label">Eng. Partner:</label>
                            </div>
                            <div class="col-md-5">
                                <select asp-for="EngagementPartner" asp-items="@ViewBag.Revisores" id="revisoEngagement" class="form-select form-select-sm"
                                        data-placeholder="Seleccione Engagement Partner"
                                        data-value="@Model.EngagementPartner"
                                        disabled>
                                    <option value="">Seleccione Engagement Partner</option>
                                </select>
                                <input type="hidden" asp-for="EngagementPartner" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="EngagementPartnerFecha" type="text" id="revisoEngagementFecha" class="form-control form-control-sm" placeholder="Fecha" data-date-toggle />
                            </div>
                            <div class="col-md-2 text-center">
                                <estado-badge etapa="EngagementPartner" estados="@(estadosDeHoja)"></estado-badge>
                            </div>
                        </div>

                        <div class="row mt-3 @(string.Equals(etapaActual, "SocioFirmante", StringComparison.OrdinalIgnoreCase) ? "workflow-stage-row is-current-stage" : "workflow-stage-row")">
                            <div class="col-md-2">
                                <label for="SocioFirmante" class="form-label required-inline-label">
                                    <span>Socio firmante:</span>
                                    <span class="text-danger">*</span>
                                </label>
                            </div>
                            <div class="col-md-5">
                                <select asp-for="SocioFirmante" asp-items="@ViewBag.Socios"
                                        id="revisoSocioFirmante" class="form-select form-select-sm"
                                        data-placeholder="Seleccione Socio Firmante"
                                        >
                                    <option value="">Seleccione Socio Firmante</option>
                                </select>
                                <span asp-validation-for="SocioFirmante" class="text-danger small"></span>
                                <input type="hidden" asp-for="SocioFirmante" />
                            </div>
                            <div class="col-md-3">
                                <input asp-for="SocioFirmanteFecha" type="text" id="revisoSocioFirmanteFecha" class="form-control form-control-sm" placeholder="Fecha" data-date-toggle />
                            </div>
                            <div class="col-md-2 text-center">
                                <estado-badge etapa="SocioFirmante" estados="@(estadosDeHoja)"></estado-badge>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col-md-2">
                                <label for="FechaLimite" class="form-label">Fecha Limite:</label>
                            </div>
                            <div class="col-md-3">
                                <input asp-for="FechaLimite" type="text" id="fechaLimite" class="form-control form-control-sm" placeholder="Fecha limite" data-date-toggle />
                            </div>
                            <div class="col-md-2 text-end">
                                <label for="GestorFinal" class="form-label">Gestor Final:</label>
                            </div>
                            <div class="col-md-5">
                                <select asp-for="GestorFinal" asp-items="@ViewBag.Gestores"
                                        id="gestorFinal" class="form-select form-select-sm">
                                    <option value="">Seleccione Gestor Final</option>
                                </select>
                                <span asp-validation-for="GestorFinal" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mt-3">
                            <div class="col" id="lugarFirmaDiv">
                                <div class="row">
                                    <div class="col-md-5">
                                        <label for="lugarFirmaDoc" class="form-label">Lugar de firma: <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="col-md-7">
                                        <select asp-for="LugarFirma" asp-items="@ViewBag.Jurisdicciones" id="lugarFirmaDoc" class="form-select form-select-sm">
                                            <option value="">Seleccione lugar de firma</option>
                                        </select>
                                        <span asp-validation-for="LugarFirma" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="col invisible" id="fechaDeCierreDiv">
                                <div class="row">
                                    <div class="col-md-4">
                                        <label for="FechaDeCierre" class="form-label">Fecha de Cierre:</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input asp-for="FechaDeCierre" type="text" id="fechaDeCierre" class="form-control form-control-sm" placeholder="Fecha de cierre" data-date-toggle />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="row">
                            <div class="col-md-3">
                                <label for="RutaPapeles" class="form-label">Ruta papeles: <span class="text-danger">*</span></label>
                            </div>
                            @* <div class="col-md-9">
                                <label for="archivo" class="btn btn-primary">
                                    Seleccionar archivo
                                    <input type="file" id="archivo" class="d-none">
                                </label>
                                <input asp-for="RutaPapeles" type="text" class="form-control form-control-sm" id="rutaPapeles" placeholder="Ruta de papeles de trabajo">
                                <span asp-validation-for="RutaPapeles" class="text-danger small"></span>
                            </div> *@
                            <div class="col-md-9">
                                <div class="input-group input-group-sm">
                                    <input asp-for="RutaPapeles" type="text" class="form-control form-control-sm" id="rutaPapeles" placeholder="Ruta de papeles de trabajo">
                                    <label for="archivoRutaPapelesPath" class="input-group-text btn bg-bdo">
                                        <i class="bi bi-arrow-bar-up"></i>
                                        <input type="file" id="archivoRutaPapelesPath" class="d-none">
                                    </label>
                                    <!-- Espaciador para alinear con el botón de clip de abajo -->
                                    <span class="input-group-text border-0 bg-transparent p-0" style="width: 40px;"></span>
                                </div>
                                <span asp-validation-for="RutaPapeles" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label for="RutaDoc" class="form-label">Ruta doc.: <span class="text-danger">*</span></label>
                            </div>
                            @* <div class="col-md-9">
                                <input asp-for="RutaDoc" type="text" class="form-control form-control-sm" id="rutaDoc" placeholder="Ruta de documento">
                                <span asp-validation-for="RutaDoc" class="text-danger small"></span>
                            </div> *@
                            <div class="col-md-9">
                                <div class="input-group input-group-sm">
                                    <input asp-for="RutaDoc" type="text" class="form-control form-control-sm" id="rutaDoc" placeholder="Ruta de documento">
                                    <label for="archivoRutaDocPath" class="input-group-text btn bg-bdo">
                                        <i class="bi bi-arrow-bar-up"></i>
                                        <input type="file" id="archivoRutaDocPath" class="d-none">
                                    </label>
                                    <label for="archivoRutaDoc" class="input-group-text btn btn-outline-secondary" title="Adjuntar archivo">
                                        <i class="bi bi-paperclip"></i>
                                        <input type="file" id="archivoRutaDoc" name="archivoDoc" class="d-none">
                                    </label>
                                </div>
                                <small class="text-muted">Tamaño máximo permitido para adjuntos: @maxUploadFileSizeLabel.</small>
                                <br />
                                <span asp-validation-for="RutaDoc" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label for="Adjuntos" class="form-label">Adjuntos:</label>
                            </div>
                            <div class="col-md-9">
                                <textarea asp-for="Adjuntos" class="form-control d-none" id="adjuntos" rows="1" placeholder="Archivos adjuntos" readonly></textarea>
                                <div id="contenedorAdjunto" class="mt-1 d-none">
                                    <div class="badge bg-bdo d-inline-flex align-items-center p-2 rounded-2">
                                        <i class="bi bi-file-earmark-check me-2"></i>
                                        <span id="nombreAdjunto" class="me-2 text-truncate" style="max-width: 200px;"></span>
                                        @if ((bool?)ViewBag.AttachmentCanOpen == true)
                                        {
                                            <a href="@Url.Action("AbrirAdjuntoPrincipal", "Home", new { id = Model.Id })"
                                               target="_blank"
                                               class="btn btn-sm btn-light py-0 px-1 me-1"
                                               title="Abrir adjunto">
                                                <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                            <a href="@Url.Action("AbrirAdjuntoPrincipal", "Home", new { id = Model.Id, download = true })"
                                               class="btn btn-sm btn-light py-0 px-1 me-2"
                                               title="Descargar adjunto">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        }
                                        <button type="button" class="btn-close btn-close-white" style="font-size: 0.5rem;" id="btnEliminarAdjunto" title="Quitar archivo"></button>
                                    </div>
                                </div>
                                <span asp-validation-for="Adjuntos" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label for="Observaciones" class="form-label">Observaciones:</label>
                            </div>
                            <div class="col-md-9">
                                <textarea asp-for="Observaciones" class="form-control" id="observaciones" rows="3" placeholder="Observaciones"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </fieldset>

            <div class="row mt-3 align-items-center">
                <div class="col-md-7 d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" asp-action="Index" class="btn btn-sm bg-bdo me-1"> <i class="bi bi-arrow-90deg-left"></i> Volver al Inicio </button>

                    @if (@String.IsNullOrEmpty(Model.Id))
                    {
                        <button id="btnCrear" asp-action="Upsert" asp-route-mode="0" method="post"
                                type="submit" class="btn btn-sm btn-success me-2" data-operation-mode="Create">
                            <i class="bi bi-plus-lg"></i> Crear hoja
                        </button>
                    }
                    else
                    {
                        @if (!@ViewBag.Detail)
                        {
                            @* <button id="btnVer" type="submit" class="btn btn-info"> <i class="bi bi-file-earmark-bar-graph"></i> Ver Documentos </button> *@

                            @if (@Model.Estado == 0)
                            {
                                <button id="btnModificar" asp-route-mode="Update"
                                        type="submit" asp-controller="Home" data-operation-mode="Update"
                                        class="btn btn-sm btn-secondary me-1">
                                    <i class="bi bi-floppy"></i> Guardar Cambios
                                </button>
                            }

                            @if (botonesHabilitados)
                            {
                                <button id="btnFirmar" asp-action="FirmarDoc" type="button"
                                        class="btn btn-sm btn-success me-1
                                                                @(string.Equals(etapaActual, "SocioFirmante", StringComparison.OrdinalIgnoreCase) ? "" : "d-none")">
                                    <i class="bi bi-pencil-fill"></i>
                                    Firmar Documento
                                </button>

                                <button id="btnAprobar" asp-action="RevisarEtapa" type="button"
                                        class="btn btn-sm btn-success me-1
                                                    @(string.Equals(etapaActual, "SocioFirmante", StringComparison.OrdinalIgnoreCase) ? "d-none" : "")">
                                    <i class="bi bi-check-lg"></i>
                                    Aprobar
                                </button>

                                @* <button id="btnAprobar" asp-action="RevisarEtapa" type="button" class="btn btn-success me-1"><i class="bi bi-check-lg"></i> Aprobar </button> *@

                                <button id="btnRechazar" asp-action="RevisarEtapa" type="button"
                                        class="btn btn-sm btn-danger">
                                    <i class="bi bi-x-lg"></i> Rechazar
                                </button>
                            }
                        }
                        else
                        {
                            @if (@Model.Estado == 0)
                            {
                                @if (puedeModificar)
                                {
                                    <a id="btnModificar" asp-controller="Home" asp-action="Upsert"
                                       asp-route-mode="Update" asp-route-id="@Model.Id"
                                       class="btn btn-sm btn-secondary me-2" role="button">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </a>
                                }
                                else
                                {
                                    <span id="btnModificar" class="btn btn-sm btn-secondary me-2 disabled"
                                          role="button" aria-disabled="true"
                                          title="No podés modificar esta hoja porque no sos el responsable de la etapa actual.">
                                        <i class="bi bi-pencil"></i> Modificar
                                    </span>
                                }
                            }
                        }
                    }

                    <button id="btnAuditoria" type="button"
                            class="btn btn-sm btn-info me-2 invisible">
                        <i class="bi bi-list-task"></i> Abrir Auditoria
                    </button>
                </div>

        </form>

        <div class="col-md-5">
            <div class="footer-side-panel ms-md-auto">
                @if (!string.IsNullOrWhiteSpace(rechazo))
                {
                    <p class="text-danger mb-0"><strong>Motivo de rechazo: </strong> @rechazo</p>
                }
                else if (Model.Estado == (int)Estado.Aprobada)
                {
                    <form id="formDescargarHoja" asp-controller="Home" asp-action="GenerarArchivoHoja" method="post"
                          class="btn-download-form d-inline-flex align-items-baseline gap-2 flex-nowrap">

                        <input type="hidden" name="hojaId" value="@Model.Id" />

                        <label for="formato" class="mb-0 me-2 pt-1">Descargar Hoja:</label>

                        <select id="formato" name="formato"
                                class="form-select form-select-sm w-auto me-2" required>
                            <option value="">Seleccione...</option>
                            <option value="pdf">PDF</option>
                            <option value="word">Word (.docx)</option>
                        </select>

                        <button type="submit" class="btn btn-sm bg-bdo btn-sm ms-1 d-flex align-items-center" title="Descargar Hoja">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-download"></i>
                        </button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Id))
                {
                    <div id="notificationStatusPanel" class="accordion notification-status-accordion d-none" data-hoja-id="@Model.Id">
                        <div class="accordion-item notification-status-item-shell">
                            <h2 class="accordion-header" id="notificationStatusHeader">
                                <button class="accordion-button collapsed notification-status-toggle" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#notificationStatusCollapse"
                                        aria-expanded="false" aria-controls="notificationStatusCollapse">
                                    <span class="notification-status-title">Notificaciones</span>
                                    <span id="notificationStatusSummary" class="notification-status-summary"></span>
                                </button>
                            </h2>
                            <div id="notificationStatusCollapse" class="accordion-collapse collapse" aria-labelledby="notificationStatusHeader">
                                <div class="accordion-body notification-status-body">
                                    @Html.AntiForgeryToken()
                                    <ul id="notificationStatusList" class="notification-status-list mb-0"></ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div id="operationProgressOverlay" class="operation-progress-overlay d-none" aria-live="polite" aria-modal="true" role="dialog">
    <div id="operationProgressCard" class="operation-progress-card">
        <div class="operation-progress-header">
            <div class="operation-progress-kicker">Hoja de Ruta</div>
            <h4 id="operationProgressTitle" class="mb-1">Procesando</h4>
            <p id="operationProgressMessage" class="mb-0 text-white-50">Preparando operación...</p>
        </div>
        <div class="operation-progress-body">
            <ul id="operationProgressSteps" class="operation-progress-steps"></ul>
        </div>
        <div class="operation-progress-footer">
            <button id="operationProgressClose" type="button" class="btn btn-outline-secondary d-none">Cerrar</button>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ModalAprobacion")
@await Html.PartialAsync("_ModalConfirmacion", Model)
@await Html.PartialAsync("_ModalAuditoria", Model)

<div class="modal fade" id="confirmacionJerarquiaRevisoresModal" tabindex="-1" aria-labelledby="confirmacionJerarquiaRevisoresTitulo" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmacionJerarquiaRevisoresTitulo">Revisores del flujo</h5>
            </div>
            <div class="modal-body" id="confirmacionJerarquiaRevisoresMensaje"></div>
            <div class="modal-footer">
                <button type="button" id="cancelarCambioJerarquiaRevisores" class="btn btn-outline-secondary">CANCELAR</button>
                <button type="button" id="continuarCambioJerarquiaRevisores" class="btn btn-primary">CONTINUAR</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script type="application/json" id="upsertConfig">@Html.Raw(JsonSerializer.Serialize(new {
        revisoresData = ViewBag.RevisoresFull,
        genericosData = ViewBag.NombreGenericoFull,
        subareasJson = ViewBag.Subareas as string ?? "[]",
        clientesJson = ViewBag.ClientesJson as string ?? "[]",
        cliente = Model.Cliente,
        currentSubarea = Model.Subarea,
        codCliente = Model.CodCliente,
        selectedContract = Model.ContratoPlataforma ?? "",
        validarNumeroCreateUrl = Url.Action("ValidarNumeroCreate", "Home"),
        indexUrl = Url.Action("Index", "Home"),
        uploadSettings = new {
            maxFileSizeBytes = maxUploadFileSizeBytes,
            maxFileSizeLabel = maxUploadFileSizeLabel
        }
    }))</script>
    <script src="~/js/upsert.js" asp-append-version="true"></script>
}

