@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
    var estadosJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.Estados);
    var currentEmpleadoJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.CurrentEmpleado as string ?? string.Empty);
}

<div class="container-fluid content-wrapper">

    <div id="alertContainer" class="mt-2">
        @if (!string.IsNullOrWhiteSpace(ViewBag.IndexAlertMessage as string))
        {
            <div class="alert alert-@(ViewBag.IndexAlertType ?? "warning") alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.IndexAlertMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
    </div>

    <div class="mt-3">
        <a class="btn btn-sm btn-success" asp-controller="Home" asp-action="Upsert" asp-route-mode="0">
            <i class="bi bi-plus-lg"></i> Crear Hoja
        </a>

        <a class="btn btn-sm btn-info ms-2" asp-controller="Home" asp-action="Reportes">
            <i class="bi bi-bar-chart-fill"></i> Generar Reportes
        </a>
    </div>

    <div class="accordion mt-3 mb-3" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingOne">
                <button class="accordion-button bg-bdo text-white" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                    <i class="bi bi-filter me-2"></i> Filtrar hojas de ruta
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#accordionExample">
                <div class="accordion-body p-0">
                    <div class="card mt-3 mb-3 border-0">
                        <div class="card-body py-1">
                            <div class="row mb-3">
                                <div class="col-md-1 mb-2">
                                    <input type="text" id="filtroNumero" class="form-control" placeholder="N° HR" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <input type="text" id="filtroCliente" class="form-control" placeholder="Cliente" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <select id="filtroEstado" class="form-control">
                                        <option value="">Todos los Estados</option>
                                        @foreach (var estado in ViewBag.Estados)
                                        {
                                            <option value="@estado.Id">@estado.Desc</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-1 mb-2">
                                    <input type="text" id="filtroSector" class="form-control" placeholder="Sector" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <input type="text" id="filtroSocio" class="form-control" placeholder="Socio" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <input type="date" id="filtroDesde" class="form-control" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <input type="date" id="filtroHasta" class="form-control" />
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-md-1 mb-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text" data-bs-toggle="tooltip" title="Registros por página">
                                            <i class="bi bi-list-nested"></i>
                                        </span>
                                        <input type="number" min="1" class="form-control" id="inputPageSize" value="@(ViewBag.InitialPageSize ?? 10)" />
                                    </div>
                                </div>
                                <div class="col-md-1 mb-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text" data-bs-toggle="tooltip" title="Ir a página Nro">
                                            <i class="bi bi-box-arrow-in-right"></i>
                                        </span>
                                        <input type="number" min="1" class="form-control" id="inputGoToPage" value="1" />
                                    </div>
                                </div>
                                <div class="col-md-2 mb-2">
                                    <button class="btn btn-sm btn-secondary" id="btnResetFilters" type="button">
                                        <i class="bi bi-trash3 me-2"></i>
                                        Limpiar Filtros
                                    </button>
                                </div>
                                <div class="col-md-2 mb-2">
                                    <button id="btnTogglePendientes" class="btn btn-success btn-sm" type="button">
                                        <i class="bi bi-eye"></i>
                                        @(ViewBag.Pendientes ? "Mostrar todas" : "Mostrar pendientes")
                                    </button>
                                </div>
                                <div class="col-md-4 mb-2 d-flex align-items-center">
                                    <small id="indexStatus" class="text-muted"></small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive position-relative" style="max-height: 400px; overflow-y: auto;">
        <div id="tableLoading" class="position-absolute top-0 start-0 w-100 h-100 d-none align-items-center justify-content-center bg-white bg-opacity-75" style="z-index: 2;">
            <div class="text-center">
                <div class="spinner-border text-secondary mb-2" role="status"></div>
                <div class="small text-muted">Actualizando resultados...</div>
            </div>
        </div>

        <table class="table table-sm table-hover table-bordered mb-0">
            <thead class="bg-bdo text-white">
                <tr>
                    <th class="text-center fw-normal sortable" data-sort="Numero">Número <span id="sort-icon-Numero"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="ClienteName">Cliente <span id="sort-icon-ClienteName"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="NombreGenerico">Tipo Documento <span id="sort-icon-NombreGenerico"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="Sector">Sector <span id="sort-icon-Sector"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="SocioFirmanteDetalle">Socio Firmante <span id="sort-icon-SocioFirmanteDetalle"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="FechaDocumento">Fecha <span id="sort-icon-FechaDocumento"></span></th>
                    <th class="text-center fw-normal sortable" data-sort="Estado">Estado <span id="sort-icon-Estado"></span></th>
                    <th class="text-center fw-normal">Acciones</th>
                </tr>
            </thead>
            <tbody id="hojasBody"></tbody>
        </table>
    </div>

    <div class="card-footer text-end mt-2 bg-white">
        <nav>
            <ul class="pagination justify-content-end mb-2" id="pagination"></ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="indexConfig">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { estados = ViewBag.Estados, currentEmpleado = ViewBag.CurrentEmpleado as string ?? string.Empty, pendientes = ViewBag.Pendientes }))</script>
    <script src="~/js/index.js" asp-append-version="true"></script>
}
