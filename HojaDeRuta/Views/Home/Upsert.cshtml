                    }

                    <button id="btnAuditoria" type="button"
                            class="btn btn-sm btn-info me-2 invisible"
                            onclick="abrirModalAuditoria()">
                        <i class="bi bi-list-task"></i> Abrir Auditoria
                    </button>
                </div>

        </form>

        <div class="col-md-5">
            <div class="footer-side-panel ms-md-auto">
                @if (!string.IsNullOrWhiteSpace(rechazo))
                {
                    <p class="text-danger mb-0"><strong>Motivo de rechazo: </strong> @rechazo</p>
                }
                else if (Model.Estado == (int)Estado.Aprobada)
                {
                    <form id="formDescargarHoja" asp-controller="Home" asp-action="GenerarArchivoHoja" method="post"
                          class="btn-download-form d-inline-flex align-items-baseline gap-2 flex-nowrap">

                        <input type="hidden" name="hojaId" value="@Model.Id" />

                        <label for="formato" class="mb-0 me-2 pt-1">Descargar Hoja:</label>

                        <select id="formato" name="formato"
                                class="form-select form-select-sm w-auto me-2" required>
                            <option value="">Seleccione...</option>
                            <option value="pdf">PDF</option>
                            <option value="word">Word (.docx)</option>
                        </select>

                        <button type="submit" class="btn btn-sm bg-bdo btn-sm ms-1 d-flex align-items-center" title="Descargar Hoja">
                            <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                            <i class="bi bi-download"></i>
                        </button>
                    </form>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Id))
                {
                    <div id="notificationStatusPanel" class="accordion notification-status-accordion d-none" data-hoja-id="@Model.Id">
                        <div class="accordion-item notification-status-item-shell">
                            <h2 class="accordion-header" id="notificationStatusHeader">
                                <button class="accordion-button collapsed notification-status-toggle" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#notificationStatusCollapse"
                                        aria-expanded="false" aria-controls="notificationStatusCollapse">
                                    <span class="notification-status-title">Notificaciones</span>
                                    <span id="notificationStatusSummary" class="notification-status-summary"></span>
                                </button>
                            </h2>
                            <div id="notificationStatusCollapse" class="accordion-collapse collapse" aria-labelledby="notificationStatusHeader">
                                <div class="accordion-body notification-status-body">
                                    @Html.AntiForgeryToken()
                                    <ul id="notificationStatusList" class="notification-status-list mb-0"></ul>
                                </div>
