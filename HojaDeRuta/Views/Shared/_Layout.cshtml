<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hoja de Ruta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HojaDeRuta.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header class="bg-bdo">
        <div class="content-wrapper container">
            <nav class="navbar navbar-expand-sm navbar-light" style="height: 60px;">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/img/bdo.svg" style="max-height: 50px;" alt="HojaDeRuta">
                    </a>

                    @if (ViewBag.CurrentSection == "Home")
                    {
                        <div class="collapse navbar-collapse justify-content-center">
                            <ul class="nav justify-content-center">
                                @*<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Upsert" asp-route-mode=0>Crear Hoja</a></li>
                                <li class="nav-item"><a class="nav-link" href="#">Seguimiento</a></li>
                                <li class="nav-item"><a class="nav-link">Check workflow</a></li>
                                <li class="nav-item"><a class="nav-link">Ver mis hojas</a></li> *@
                            </ul>
                        </div>
                    }

                    @* <div class="d-sm-inline-flex justify-content-end">
                        <a class="navbar-brand text-white fw-bolder" asp-area="" asp-controller="Home" asp-action="Index">Hoja de Ruta</a>
                    </div> *@
                    <div class="d-flex flex-column align-items-end text-white">
                        <a class="navbar-brand fw-bolder text-white mb-0 me-0" asp-area="" asp-controller="Home" asp-action="Index">
                            Hoja de Ruta
                        </a>
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-white-50 d-inline">
                                <i class="bi bi-person-fill"></i> @User.Identity?.Name
                            </small>
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <form asp-controller="Home" asp-action="SignOut" method="post" class="m-0" id="signOutForm">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm text-white-50 border-0 bg-transparent p-0 d-inline-flex align-items-center"
                                            title="Cerrar sesión"
                                            aria-label="Cerrar sesión">
                                        <i class="bi bi-box-arrow-right"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </nav>
        </div>
    </header>

    <main role="main">
        <div class="content-wrapper container">
            <div id="globalAlertContainer" class="mt-2"></div>
            @RenderBody()
        </div>
    </main>

    <footer class="footer border-top bg-bdo py-0 mt-3">
        <div class="container text-center">
            BDO - &copy; @DateTime.Now.Year - Hoja de Ruta
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const signOutForm = document.getElementById('signOutForm');
            const alertContainer = document.getElementById('globalAlertContainer');

            if (!signOutForm || !alertContainer) {
                return;
            }

            signOutForm.addEventListener('submit', function (event) {
                if (signOutForm.dataset.submitting === 'true') {
                    return;
                }

                event.preventDefault();
                signOutForm.dataset.submitting = 'true';

                alertContainer.innerHTML = `
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        Cerrando sesión...
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>`;

                window.setTimeout(function () {
                    signOutForm.submit();
                }, 250);
            });
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
